# Copy this file to .streamlit/secrets.toml and paste your key.
# secrets.toml is private: .gitignore stops it going to GitHub.
# Use a Gemini key from https://aistudio.google.com/apikey (the organizers' hackathon API only accepts text, not scans).
GEMINI_API_KEY = "paste-your-gemini-key-here"

# The organizers' hackathon key (text only). Used to write the correction note. Leave empty to skip.
HACKATHON_API_KEY = ""

# Optional settings (remove the # to use one):
# GEMINI_MODEL = "gemini-3.8-flash"         # a newer model: a little more accurate, but slower
# GEMINI_SECOND_OPINION = "0"               # read each form once instead of twice (half the calls, if you hit limits)
# GEMINI_IMAGE_DETAIL = "medium"            # faster reading; check handwriting is still read correctly
# QUICK_ID = "0"                            # turn off the instant layout match (always ask Gemini which form it is)
